# Standalone RNS instance for rns-alerts (its own LXMF identity). Connects to the
# .229 local rnsd hub over TCP -- same pattern as the other quasarke services on
# this host. Does NOT ride a shared-instance socket.
[reticulum]
  enable_transport = No
  share_instance = No
  instance_name = quasarke_alerts
[logging]
  loglevel = 4
[interfaces]
  [[Local Peering Hub]]
    type = TCPClientInterface
    interface_enabled = True
    enabled = True
    target_host = 127.0.0.1
    target_port = 4343
  [[Parallel Public Net]]
    type = TCPClientInterface
    interface_enabled = True
    enabled = True
    target_host = rns1.buildwithparallel.com
    target_port = 4242
